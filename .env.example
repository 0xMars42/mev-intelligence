# mev-intelligence — configuration runtime
# Copier en `.env` et decommenter ce qu'on veut surcharger. Tourne sans .env.

# WebSocket Ethereum mainnet (pending full tx bodies). Le public node supporte
# `subscribe_full_pending_transactions` sans cle API.
# ETH_WS_URL=wss://ethereum-rpc.publicnode.com

# Base de donnees sqlx. SQLite local par defaut (fichier cree si absent).
# Cible scale-path : Postgres (ex: postgres://user:pass@localhost/mev_intel).
# DATABASE_URL=sqlite://mev_intel.db

# Periode des logs de stats cumulees (secondes).
# MEV_STATS_SECS=5

# --- Validation (P3.2) : lecture des receipts pour figer l'outcome ----------
# Periode de la passe de validation (secondes).
# MEV_VALIDATE_EVERY_SECS=30
# Age mini d'une pending tx avant de tenter sa validation (lui laisser le temps
# d'etre minee, sinon NotMined serait un faux negatif).
# MEV_VALIDATE_MIN_AGE_SECS=60
# Age au-dela duquel une tx toujours sans receipt est figee NotMined (droppee).
# MEV_VALIDATE_MAX_AGE_SECS=300
